#include <Servo.h>

Servo mg90;                 // 舵机对象
const uint8_t SERVO_PIN = 9;   // 舵机信号线接 D9
const uint8_t LED_PIN   = 13;  // 板载 LED

const int ANGLE_A = 0;      // 位置 A
const int ANGLE_B = 180;    // 位置 B
const unsigned long HOLD_MS = 1000;  // 每个位置停留时间

void setup() {
  pinMode(LED_PIN, OUTPUT);
  mg90.attach(SERVO_PIN);   // 默认 544~2400us 脉宽
  mg90.write(ANGLE_A);
}

void loop() {
  // 转到 A，LED 亮
  digitalWrite(LED_PIN, HIGH);
  mg90.write(ANGLE_A);
  delay(HOLD_MS);

  // 转到 B，LED 灭
  digitalWrite(LED_PIN, LOW);
  mg90.write(ANGLE_B);
  delay(HOLD_MS);
}